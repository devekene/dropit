{
  "name": "dropit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @dropit/web dev",
    "dev:api": "pnpm --filter @dropit/api dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@dropit/web",
    "build:api": "turbo run build --filter=@dropit/api",
    "start": "turbo run start",
    "start:web": "pnpm --filter @dropit/web start",
    "start:api": "pnpm --filter @dropit/api start",
    "typecheck": "turbo run typecheck",
    "check:governance": "python3 scripts/check_governance.py",
    "check:ui": "node scripts/check-ui-lines.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:foundation": "node --test scripts/foundation-smoke.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:foundation",
    "check:enforcement": "node scripts/check-enforcement.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
