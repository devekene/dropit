# Optional. API reads exported process variables; no automatic .env loading.
# Start with: API_PORT=3001 NODE_ENV=development pnpm dev:api
API_PORT=3001
NODE_ENV=development

# Required only by database migration/connection commands in Slice 03.
# Replace the password and database name; never commit a real credential.
DATABASE_URL=postgresql://dropit:replace-me@127.0.0.1:5432/dropit

# Required only by R2 storage integration/runtime commands from Slice 05 onward.
# Keep real values in the ignored apps/api/.env.local file or a secret manager.
S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=replace-with-private-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
APP_ORIGIN=http://127.0.0.1:3000
