# Optional. API reads exported process variables; no automatic .env loading.
# Start with: API_PORT=3001 NODE_ENV=development pnpm dev:api
API_PORT=3001
NODE_ENV=development

# Required only by database migration/connection commands in Slice 03.
# Replace the password and database name; never commit a real credential.
DATABASE_URL=postgresql://dropit:replace-me@127.0.0.1:5432/dropit
